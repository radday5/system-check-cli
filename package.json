{
  "name": "system-check-cli",
  "version": "1.3.0",
  "description": "A Node.js tool for Windows system maintenance.",
  "main": "index.js",
  "type": "module",
  "bin": {
    "system-check": "./index.js",
    "system-check-cli": "./index.js"
  },
  "files": [
    "index.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start:install": "npm run startup:install",
    "start:uninstall": "npm run startup:uninstall",
    "startup:install": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/manage-startup.ps1 -Action install",
    "startup:uninstall": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/manage-startup.ps1 -Action uninstall"
  },
  "keywords": [
    "cli",
    "system",
    "maintenance",
    "windows"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chalk": "^5.6.2",
    "inquirer": "^13.3.2",
    "ora": "^9.3.0",
    "yargs": "^18.0.0"
  }
}
