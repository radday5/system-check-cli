{
  "name": "winslopr",
  "version": "26.05.05",
  "description": "A Node.js tool for removing Windows slop and system maintenance.",
  "main": "index.js",
  "type": "module",
  "bin": {
    "winslopr": "./index.js"
  },
  "files": [
    "index.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start:install": "npm run startup:install",
    "start:uninstall": "npm run startup:uninstall",
    "startup:install": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/manage-startup.ps1 -Action install",
    "startup:uninstall": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/manage-startup.ps1 -Action uninstall"
  },
  "keywords": [
    "cli",
    "system",
    "maintenance",
    "windows"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chalk": "^5.6.2",
    "inquirer": "^13.4.1",
